# Omega Broker Bridge configuration (/etc/omega-bridge/env, mode 0600)
OMEGA_URL=https://nexus.cryptophys.work/omega
CF_ACCESS_CLIENT_ID=replace-with-access-client-id
CF_ACCESS_CLIENT_SECRET=replace-with-access-client-secret
OMEGA_STATE_DIR=/var/lib/omega-bridge
MT5_FILES_DIR="/opt/mt5-ingestion-gateway/prefix/drive_c/Program Files/MetaTrader 5/MQL5/Files/omega"
TERMINAL_INI=/opt/mt5-ingestion-gateway/config/terminal_gateway.ini
TERMINAL_SERVICE=mt5-terminal.service
OMEGA_TAKE_STARTUP=true
OMEGA_SYMBOL=XAUUSD
OMEGA_SYNC_MS=5000
