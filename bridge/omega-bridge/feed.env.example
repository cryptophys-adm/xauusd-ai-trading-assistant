# F2: a feed bridge instance (/etc/omega-bridge/<id>.env, mode 0600, root). Data only: never an executor.
OMEGA_ROLE=feed
OMEGA_FEED_ID=oanda
OMEGA_URL=https://nexus.cryptophys.work/omega
CF_ACCESS_CLIENT_ID=<the feed token's client id>
# The owner fills the secret in their own SSH session (sudoedit); the bridge refuses to start on the placeholder.
CF_ACCESS_CLIENT_SECRET=__OWNER_FILLS__
OMEGA_STATE_DIR=/var/lib/omega-bridge-oanda
MT5_FILES_DIR=<the feed terminal's MQL5/Files directory>
TERMINAL_INI=<the feed terminal's login ini>
TERMINAL_SERVICE=mt5-oanda.service
OMEGA_SYMBOL=XAUUSD.sml
OMEGA_SYNC_MS=15000
