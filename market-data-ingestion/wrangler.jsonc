{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "xauusd-tradingview-pull-adapter",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "MARKET_DATA_CACHE",
      "id": "4ada6196de5a4000a28a047bf6b30ff3"
    }
  ],
  // RPC Service Bindings (no shared secrets). TradingView OHLCV comes only through the news-ingestion Worker, which owns
  // the TradingView MCP OAuth grant and the account-wide quota cooldown.
  "services": [
    {
      "binding": "TV_GATEWAY",
      "service": "xauusd-fundamental-news-ingestion",
      "entrypoint": "TvGateway"
    },
    // local_computation lane -> AI Worker LocalComputationIngress.submit()
    {
      "binding": "AI_WORKER",
      "service": "xauusd-ai-trading-assistant",
      "entrypoint": "LocalComputationIngress"
    }
  ],
  "vars": {
    "TV_MAX_CALLS_PER_RUN": "8",
    // The MT5 fallback (docs/RFC_MT5_FALLBACK.md; owner 2026-11-11: trade as usual, the broker's raw price):
    // "auto" replaces the 1m chart source with the broker's bars while TradingView is down; "off" never.
    "FEED_FALLBACK_MODE": "auto",
    // Owner 2026-11-14 ("sesuaikan batas dengan kuota TV agar sama"): the same number as the account's
    // TradingView provider quota (fundamental-news-ingestion PROVIDER_DAILY_LIMIT, 500 a day, which the news
    // Worker's chart reserve also uses); test/tv-quota-alignment.test.mjs keeps the two equal. Was 800
    // (2026-11-05), above the quota, so it never held: on 2026-11-12/13 the provider refused at the 501st call
    // of the day while this budget still read room. The quota is the account's, shared with the news pulls,
    // which yield to the chart near the limit (the chart reserve).
    "TV_DAILY_CALL_BUDGET": "500",
    "CHART_MINTICK": "0.001",
    // C0 verified 5m lane: publish 5m local records for parity (timeframe-scoped ids).
    "M5_PARITY_PUBLISH": "true",
    // Verified 15m lane (owner decision 2026-11-05): 15m local records for parity.
    "M15_PARITY_PUBLISH": "true",
    // H4/D1 lane (owner decision 2026-11-05): local records for parity on the H4 and D1 charts.
    "HTF_PARITY_PUBLISH": "true",
    // Phase C2: HUD snapshots (H1 and 15m) for the HUD agents; never decision evidence.
    "HUD_SNAPSHOT_PUBLISH": "true"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Workers Logs (2026-11-10): production 13:10-14:10 UTC the 5m local records stopped publishing and
  // nothing kept this Worker's logs to say why. Persisted logs, one invocation log per cron run (1,440 a
  // day) plus the Worker's own event lines (only unusual statuses are logged); no traces.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
