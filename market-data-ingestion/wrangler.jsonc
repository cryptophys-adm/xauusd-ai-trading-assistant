{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "xauusd-tradingview-pull-adapter",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "MARKET_DATA_CACHE",
      "id": "4ada6196de5a4000a28a047bf6b30ff3"
    }
  ],
  // TradingView OHLCV comes only through the news-ingestion Worker, which owns
  // the TradingView MCP OAuth grant and the account-wide quota cooldown.
  "services": [
    {
      "binding": "TV_GATEWAY",
      "service": "xauusd-fundamental-news-ingestion"
    },
    // local_computation lane -> AI Worker POST /evidence/local-calculation
    {
      "binding": "AI_WORKER",
      "service": "xauusd-ai-trading-assistant"
    }
  ],
  "vars": {
    "TV_MAX_CALLS_PER_RUN": "8",
    "TV_DAILY_CALL_BUDGET": "1200",
    "CHART_MINTICK": "0.001"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
