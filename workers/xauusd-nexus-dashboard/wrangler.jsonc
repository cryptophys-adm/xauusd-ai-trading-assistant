{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xauusd-nexus-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nexus.cryptophys.work",
      "custom_domain": true
    }
  ],
  // Read-only chart data from the market-data Worker (RPC, no shared secret).
  "services": [
    {
      "binding": "MARKET_DATA",
      "service": "xauusd-tradingview-pull-adapter",
      "entrypoint": "MarketDataReader"
    }
  ],
  "observability": {
    "enabled": true
  }
}