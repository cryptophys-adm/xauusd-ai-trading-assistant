{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xauusd-nexus-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  // No public workers.dev or preview URL (owner, 2026-11-07): Nexus is reached only at
  // nexus.cryptophys.work, behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "nexus.cryptophys.work",
      "custom_domain": true
    }
  ],
  // Read-only chart data from the market-data Worker (RPC, no shared secret), and the AI Worker's
  // read-only dashboard API (default fetch entrypoint). Both stay inside Cloudflare: the AI Worker's
  // /api may sit behind Cloudflare Access without breaking Nexus. No secret.
  "services": [
    {
      "binding": "MARKET_DATA",
      "service": "xauusd-tradingview-pull-adapter",
      "entrypoint": "MarketDataReader"
    },
    {
      "binding": "AI_WORKER",
      "service": "xauusd-ai-trading-assistant"
    }
  ],
  // Nexus UI (React SPA in the Cerebrum Console obsidian design), built from ui/ into ui/dist by the
  // deploy and validation workflows. run_worker_first: /api routes and redirects are handled by the
  // Worker, which then serves the assets with their cache headers.
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}