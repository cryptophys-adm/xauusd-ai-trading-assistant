{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xauusd-ai-trading-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  // No public workers.dev or preview URL (owner, 2026-11-07): the Worker is reached only at
  // ai.cryptophys.work (webhook public, /api behind Cloudflare Access) and through Service Bindings.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "6 * * * *",
      "10-59/15 * * * *",
      "2-59/5 * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  // The deployed version id (owner 2026-11-11): the Knowledge Council's Nexus and Omega facts carry it,
  // so a doctrine difference counts only when measured twice from the same version.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // The push hub (ADR-0015 "Organs as cells", phase 1, owner 2026-11-14: "C. mulai kerjakan"): the Nexus
  // Worker's PushHub Durable Object, bound across scripts; the War Room publishes each step's snapshot to it.
  // No migration here: the class and its migration belong to xauusd-nexus-dashboard.
  "durable_objects": {
    "bindings": [
      { "name": "PUSH_HUB", "class_name": "PushHub", "script_name": "xauusd-nexus-dashboard" }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ROOM_TRANSCRIPTS",
      "bucket_name": "xauusd-room-transcripts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xauusd-signals",
      "database_id": "ff99b940-254e-4d44-ac1d-bccb9ed18f6e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SIGNAL_CACHE",
      "id": "4ada6196de5a4000a28a047bf6b30ff3"
    },
    {
      "binding": "WEBHOOK_BUFFER",
      "id": "a7ceeae9a1d2471980e2bc71cb38e041"
    },
    {
      "binding": "KNOWLEDGE_BASE",
      "id": "f611edadb19c4260a111eb5796f2fba7"
    }
  ],
  "vars": {
    // The 5-minute Position Manager (owner 2026-11-17: live directly, risk-reducing only, src/position-manager.mjs):
    // "off" stops it. Its council is metered as position_council with its own daily cap in USD.
    "POSITION_MANAGER_MODE": "live",
    // The strategy arm (owner 2026-11-17, ADR-0020, live directly): 1 to 3 armed strategies only, or AUTO (none armed:
    // the one best strategy by confidence x confluence). "off" restores today's choice; "shadow" records only.
    "STRATEGY_ARM_MODE": "live",
    "GRID_ADAPT_MODE": "live",
    // The strategy agents' veto rule (SV1b, src/agent-veto.mjs; owner 2026-11-24, relayed: "Build A6+A7, switch on,
    // auto-revert"): "two_sided" lets an agent that speaks on both sides no longer count against the side it also speaks
    // for (A6: the lean veto; A7: the arm veto). Back to "classic" by itself for 7 days once its latest 15 closed softened
    // trades average below 0R (KV agent-veto:auto:v1); the owner's force wins (KV agent-veto:owner:v1). Unset or any
    // other value: "classic", the vetoes as before.
    "AGENT_VETO_RULE": "two_sided",
    // The council auto-arm ceiling (platform ADR-0020 Amendment 2, merged 2026-11-17, platform main 6df9a34): "allowed"
    // lets the owner's Nexus toggle act; the toggle itself stays off until the owner turns it on. "off" keeps the
    // council to proposals.
    "STRATEGY_COUNCIL_ARM": "allowed",
    // The platform's return path for council proposals (council.decisions.read): on since 2026-11-17, once the
    // platform's V3 was live on the Forge and the AI Kernel (83a352e) and organism.json granted the capability.
    "COUNCIL_DECISIONS_POLL": "on",
    "OWNER_ACCESS_SUB": "6d015218-6ea2-5fc3-b4aa-cc98c5ced21a",
    "POSITION_COUNCIL_DAILY_USD": "5",
    // Decision Engine (owner 2026-11-10: "nyalakan GLOBAL_DECISION_WEIGHTED"): the B-11 extended witnesses
    // (key levels, regime, cross-timeframe trend, macro drivers; session as context) count in the quorum
    // with the B-11 weights. "false" restores the seven base witnesses.
    "GLOBAL_DECISION_WEIGHTED": "true",
    // Strategy agents (owner 2026-11-13: "live sekarang langsung implementasi karena strategi lebih related
    // dengan key level bukan decision"): the council may choose these agents' plans beside the default
    // zone_pullback (src/strategy-agents.mjs). A live agent whose measured record is negative over 30
    // setups goes back to shadow by itself. Empty: only the default agent is live.
    "STRATEGY_AGENTS_LIVE": "sweep_reversal,breakout_retest,range_fade,pattern_peaks,pattern_lines,pattern_curve,pattern_bars,pattern_pole,pattern_gaps,pattern_legs,pattern_event,pattern_inside",
    "STRATEGY_EXECUTION": "on",
    // Model migration (owner decision 2026-11-07): glm-5.3-flash and nemotron-3-120b-a12b stop
    // answering on 2026-11-20. The news chain and the H1 Reasoner run on gpt-oss-120b.
    "AI_MODEL_ANALYST": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_COUNSELOR": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_REASONER": "@cf/openai/gpt-oss-120b",
    "REQUIRED_SOURCES": "prophet_r38,prophet_r37_ssot,gmi_v12_70",
    // Only H1 webhooks start the AI chain; 5m/15m comparator webhooks are stored for parity only.
    "ANALYSIS_TIMEFRAMES": "60",
    // Local-primary (owner decision 2026-11-05): approved local records drive the chain;
    // TradingView webhooks only calibrate the local engines, for example monthly.
    "INDICATOR_SOURCE": "local",
    "CALIBRATION_INTERVAL_DAYS": "30",
    // Omega broker engine (owner decision 2026-11-09): enabled on the server; controlled live by the
    // "Engine enabled" toggle on the Omega page (and "Arm live" for real accounts).
    "OMEGA_ENGINE_ENABLED": "true",
    // Account Profiles phase 1 (docs/RFC_ACCOUNT_PROFILES.md §2): "on" opens nothing while OmegaExecutor is older than
    // 1.15 (planIntents note ea_outdated). On since 2026-11-18: 1.15 runs on the VPS (seen 04:17 UTC, spec validated 04:18).
    "OMEGA_EA_VERSION_GATE": "on",
    // The profile council's downgrade review (src/profile-council.mjs): on since platform ADR-0020 Amendment 5 (2026-11-18).
    "OMEGA_PROFILE_COUNCIL_DOWNGRADE": "on",
    // Corpus Oracle phase 1 (owner 2026-11-11): "shadow" keeps the broker M1 corpus of Omega's active
    // broker, pair and user; "off" ignores it. It feeds no decision in phase 1.
    // Owner 2026-11-11 ("Nyalakan, host sudah #243"): collect the broker corpus for the MT5 fallback (docs/RFC_MT5_FALLBACK.md).
    "CORPUS_ORACLE_MODE": "shadow",
    "INGEST_URL": "https://news.cryptophys.work",
    // News threads and the live room: ON in production (Phase 4, owner approval 2026-11-04). The H1 multi-agent
    // bus is retired (owner 2026-11-15); its flag became NEWS_THREADS_ENABLED. Advisory only.
    "NEWS_THREADS_ENABLED": "true",
    "MULTI_AGENT_MAX_CALLS_PER_HOUR": "20",
    // Per-role models (owner decision 2026-11-07): room agents on gemma-4 (thinking off),
    // moderators and the News Daily TLDR on gpt-oss-120b; each role with its own fallback.
    "ROOM_AGENT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "ROOM_AGENT_FALLBACK_MODEL": "@cf/openai/gpt-oss-20b",
    "MODERATOR_MODEL": "@cf/openai/gpt-oss-120b",
    "MODERATOR_FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "LIVE_ROOM_ENABLED": "true",
    "LIVE_ROOM_MAX_CALLS_PER_HOUR": "48",
    // Live War Room 15m (owner decision 2026-11-05): every agent opens on the bus, debates for at
    // most 3 minutes, and the moderator concludes for the main panel. It replaces the legacy live
    // room and the per-H1 HUD agents. About 30 calls per 15m close since 2026-11-07 (three more
    // agents: Grid Bot Protocol ported, Supertrend and Order Blocks added, P6), so 136 an hour.
    "WAR_ROOM_ENABLED": "true",
    // 2026-11-10: 170 (136 before). The cap counts a rolling 60 minutes and a room can start up to a few
    // minutes late, so the window can hold five rooms; at 15:15 four rooms held 113 calls and the 15m
    // conclusion ran out (budget_exhausted). Five rooms of about 32 calls, with headroom. The cap only
    // bounds a runaway: a room still makes the same calls.
    // 2026-11-12: 185 with the Projection Agent in the room (one more opening and rebuttal per room).
    "WAR_ROOM_MAX_CALLS_PER_HOUR": "185",
    // Timeframe War Rooms (owner decision 2026-11-06): the 1H, 4H and D1 Threads are War Rooms of
    // all agents, one per closed bar (about 29 calls each since 2026-11-07; at most three rooms in
    // one hour).
    "TF_THREADS_ENABLED": "true",
    "TF_THREADS_MAX_CALLS_PER_HOUR": "140",
    // The Calendar Agent's contrarian pre-release drift (owner 2026-11-12: "ya buatkan opsi kontrarian untuk
    // survei"): a kind whose gold drifted against the consensus significantly leans the other way. "off" holds it at 0.
    "CALENDAR_CONTRARIAN": "on",
    // The Projection Agent's chart patterns (src/chart-patterns.mjs, owner 2026-11-12): "on" | "off".
    "CHART_PATTERNS_MODE": "on",
    // TP1 at the nearest key zone, at least 1R (TP1-KZ, owner 2026-11-23; src/strategy-engine.mjs TP1_MIN_R): "on" | "off".
    "TP1_KEY_ZONE_MODE": "on",
    // The entry zone beside the plan's entry (EZ1, owner 2026-11-23; src/strategy-engine.mjs ENTRY_ZONE): "edge" |
    // "on" | "off". "on": Omega rests a limit inside it where the plan's level is through price; "edge" (EZ1b, owner
    // "setuju") also at its near edge where the plan's level is out of the placement band; "off" sends no zone.
    "ENTRY_ZONE_MODE": "edge",
    // Z0 (2026-11-24, src/zone-types.mjs): demand/supply type, strength and freshness of the Key Level Agent's zones and
    // each plan's nearest decisive opposing zone ahead, recorded only (no behaviour change): "on" | "off". "off" removes
    // every typed field (decision key_levels words, plan zone_types and opposing_ahead, the plan_setups zone columns).
    "KEY_LEVEL_ZONE_TYPES": "on",
    // Z2 (2026-11-24, src/zone-types.mjs zoneAheadCheck; owner 2026-11-23, "Langsung prioritaskan"): the guardrails'
    // zone_ahead check, no trade into a decisive opposing demand or supply zone inside max(1R, 0.75 ATR(1H)) against
    // the trend, and the same rule on the strategy agents' plans (outside the consensus and the quorum).
    // ZONE_PRIORITY "on" | "off" (unset reads "off": everything as before). ZONE_AHEAD_MODE "trend" (a with-trend plan
    // is exempt) | "all" (owner-set only: no exemption, one warning line per decision) | "record" (no check; the plan
    // keeps would_block) | "off".
    // Shipped "off" (orchestrator ruling, 2026-11-24): the gate goes on in a follow-up PR only after the typing
    // replay and the ZONE_NEED re-check run on live captures that carry 1H/4H Prophet boxes (Z1a).
    "ZONE_PRIORITY": "off",
    "ZONE_AHEAD_MODE": "trend",
    // MS2 (2026-11-23, src/mode-shadow.mjs): the shadow per-mode evidence (each mode not in force, deterministically, at
    // every 15m decision; the mode selector's evidence only): "on" | "off". "off" writes and derives no shadow row and the
    // selector reads live setups only, as before.
    "MODE_SHADOW_EVIDENCE": "on",
    // MS2: the mode probation (a selector switch to a mode with fewer than 31 live setups: half the risk on Omega's new
    // orders of that mode until it passes or fails back to the baseline): "on" | "off". "off": no probation, no scale.
    "MODE_PROBATION": "on",
    // The pattern calibration v2 fields (src/pattern-calibration.mjs, Track A PR 4): "on" | "off"; "off" strips
    // by_tf and open from the stored calibration on read (the pooled block and the factors are unchanged).
    "PATTERN_HORIZON_MODE": "on",
    // The public track record's managed exit (src/public-track-record.mjs, owner 2026-11-23): "v3" (the Signal Ledger's
    // own policy, no parity gate) | "v4" (the v4 replay, shown only on a passing parity check).
    "PUBLIC_MANAGED_SOURCE": "v3",
    // The Nexus Intelligence views (Track B; B8 GET /api/liquidity, src/liquidity-view.mjs): "on" | "off". "off" answers
    // 404 intel_views_off. Read-only, Nexus only (behind Cloudflare Access); the prices there are labelled by scale.
    "INTEL_VIEWS": "on",
    // Lens B's LIQUIDITY card in the Decision Engine (B15, src/decision-engine.mjs liquidityCard): "on" | "off". Council
    // only: never in the quorum, the guardrails or the witness weights. "off": no card, no decision.liquidity, the
    // council's prompt as before.
    "LIQUIDITY_WITNESS": "on",
    // Lens B in the 15m and 1H rooms (B16, src/lens-steps.mjs lensRoomLine): "conditions" | "brief". "conditions": the
    // risk desk's data and the moderator's prompt also read lens B's liquidity conditions (plain words, no sweep, no
    // price) while lens B is on, above its floor and fresh, and the brief stores them. "brief": the brief's line only,
    // the prompts byte for byte as before. No model call is added either way.
    "LENS_ROOM_LINE": "conditions",
    "MACRO_ROOM_ENABLED": "true",
    "MACRO_ROOM_MAX_CALLS_PER_HOUR": "30",
    // News Daily (owner decision 2026-11-06): the last 24 hours, each headline tagged once.
    "NEWS_DAILY_ENABLED": "true",
    // ADR-0015 phase 2a (owner 2026-11-15): derive room run documents hourly and compare them, in shadow.
    "ROOM_RUNS_SHADOW": "on",
    "ROOM_RUNS_READ": "on",
    "ROOM_RUNS_READ_REPLAY": "on",
    "ROOM_RUNS_READ_COMPLIANCE": "on",
    "ROOM_RUNS_READ_ALLOCATION": "on",
    "ROOM_RUNS_READ_CARDS": "on",
    "ROOM_RUNS_READ_KERNEL": "on",
    "NEWS_DAILY_MAX_CALLS_PER_HOUR": "6",
    // Room memo (owner 2026-11-11, "kurangi neuron/hari tanpa mengurangi kapabilitas"): a room step whose
    // whole request equals one answered before reuses that answer (src/room-memo.mjs). "false" = shadow:
    // the hits and the stance agreement are only counted (GET /api/ai-usage) until the owner's go.
    "ROOM_MEMO_ENABLED": "true",
    // Decision Engine Telegram heartbeat (owner 2026-11-11: "telegram bot lebih dari 1 jam tidak mengirim pesan"):
    // one "still WAIT/BUY/SELL" message after this many minutes without a message; "0" turns it off.
    "DECISION_TELEGRAM_HEARTBEAT_MINUTES": "60",
    // Aether's learned knowledge (owner 2026-11-12: "mode production harus active semua"). The shadow arm
    // tests the items a person approved in Aether (an extra opening call per agent in its audience, after
    // the 1H room and decision, at most SHADOW_KNOWLEDGE_MAX_CALLS_PER_HOUR, default 32); it never feeds a
    // live prompt. LEARNED_KNOWLEDGE_ENABLED reads the bundled pack (knowledge/learned/pack.json) into
    // the rooms: the pack changes only by an owner PR, after the shadow arm found an item better, and is
    // empty today, so it changes no prompt until then. "false" turns either off at once.
    // Call for Councils P1 (owner 2026-11-16: "tahap P1 mulai"; docs/RFC_CALL_FOR_COUNCILS.md §12): "suggest" runs the
    // hourly deterministic suggestion flags (no model call; the cards on the Call for Councils page); "off" runs
    // nothing; "on" is kept for the sessions of phase P2 and in P1 behaves as "suggest". No mode starts a session.
    "CFC_MODE": "on",
    // Shadow arms retired 2026-11-19 (owner, directly: "1+2+3 hentikan semua", then "Pertahankan, hentikan sisanya" and
    // "Hentikan seluruh arm"; the record per arm is in docs/CHANGELOG.md): the learned-note arm and its A/A arm, the
    // metric rebuttals and the model arena make no model call. Their stored rows stay. The metric opening shadow stays:
    // it was better than its control (sign test 238 vs 170, Holm p 0.003).
    // The learned-note arm reopened 2026-11-24 (KA1; the owner, relayed by the orchestrator:
    // "buka arm, biarkan system menilai dirinya sendiri"): an item with a final verdict closes by itself (better goes
    // live through learned-live; not better, holdout failed or worse retires in learned_live), so the queue flows.
    // Same cap (32 calls an hour, 6 items), kill switch and neuron breaker; its A/A arm runs with the first item, as
    // before. The metric rebuttals and the model arena stay off.
    "SHADOW_KNOWLEDGE_ENABLED": "true",
    // KA2 (platform PF3, capability knowledge.verdict): the arm's verdicts posted to the platform as the kernel agent
    // shadow-knowledge, for Aether's curator (src/knowledge-verdicts.mjs). Code default "off"; it also needs
    // SHADOW_KNOWLEDGE_ENABLED. Until the platform registers the agent, each hourly run stops at the first refusal.
    "KNOWLEDGE_VERDICT_POSTS": "on",
    "METRIC_REBUTTAL": "off",
    "MODEL_ARENA": "off",
    "LEARNED_KNOWLEDGE_ENABLED": "true"
  },
  "routes": [
    {
      "pattern": "ai.cryptophys.work",
      "custom_domain": true
    }
  ],
  "previews": {
    "vars": {
      "AI_MODEL_ANALYST": "@cf/openai/gpt-oss-120b",
      "AI_MODEL_COUNSELOR": "@cf/openai/gpt-oss-120b",
      "AI_MODEL_REASONER": "@cf/openai/gpt-oss-120b",
      "REQUIRED_SOURCES": "prophet_r38,prophet_r37_ssot,gmi_v12_70",
      "INGEST_URL": "https://xauusd-fundamental-news-ingestion-preview.workers.dev"
    },
    "kv_namespaces": [
      {
        "binding": "SIGNAL_CACHE",
        "id": "0cbd6ecc0fbc4dc99342960456ca71e5"
      },
      {
        "binding": "WEBHOOK_BUFFER",
        "id": "2000943b5db042f582b03043c75d5b1c"
      },
      {
        "binding": "KNOWLEDGE_BASE",
        "id": "773182e4a26c444e8f56c3e58a1987ef"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "90f53f14-ff7b-46c1-b146-a1efd4e13018"
      }
    ],
    "ai": {
      "binding": "AI"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "services": [
    {
      "binding": "NEWS_INGESTION",
      "service": "xauusd-fundamental-news-ingestion",
      "entrypoint": "NewsIngestionService",
      "environment": "production"
    },
    // Cryptophys Platform AI Kernel (RFC_INDICATOR_AGENT_PLATFORM P4): advisory reports from the
    // 21 agents this Worker hosts. No secret: the kernel trusts the pinned host_worker. Never
    // change host_worker, and never add this binding to another Worker or to the preview config.
    {
      "binding": "AGENTS",
      "service": "cryptophys-ai-kernel",
      "entrypoint": "AgentRpc",
      "props": { "host_worker": "xauusd-ai-trading-assistant" }
    },
    // Aether, the Knowledge Guardian (RFC_AETHER_KNOWLEDGE_GUARDIAN A5, owner go 2026-11-07): the sweep
    // pushes decision cards (no levels) to cryptophys-aether KnowledgeIngress, hourly. No secret.
    // Production only; never add it to the preview config.
    {
      "binding": "AETHER",
      "service": "cryptophys-aether",
      "entrypoint": "KnowledgeIngress"
    },
    // Aether's read-only sync checks (hardening 2026-11-09): the health alerts read AetherReader.sync()
    // every 15 minutes and compare Aether's KB hash with this repository's. Production only.
    {
      "binding": "AETHER_READER",
      "service": "cryptophys-aether",
      "entrypoint": "AetherReader"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "XAUUSD_EVENTS",
        "queue": "xauusd-webhook-events"
      }
    ],
    "consumers": [
      {
        "queue": "xauusd-webhook-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "xauusd-webhook-events-dlq",
        "retry_delay": 30,
        "max_concurrency": 1
      }
    ]
  }
}
