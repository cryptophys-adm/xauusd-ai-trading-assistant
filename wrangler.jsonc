{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xauusd-ai-trading-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  // No public workers.dev or preview URL (owner, 2026-11-07): the Worker is reached only at
  // ai.cryptophys.work (webhook public, /api behind Cloudflare Access) and through Service Bindings.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "6 * * * *",
      "10-59/15 * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  // The deployed version id (owner 2026-11-11): the Knowledge Council's Nexus and Omega facts carry it,
  // so a doctrine difference counts only when measured twice from the same version.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xauusd-signals",
      "database_id": "ff99b940-254e-4d44-ac1d-bccb9ed18f6e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SIGNAL_CACHE",
      "id": "4ada6196de5a4000a28a047bf6b30ff3"
    },
    {
      "binding": "WEBHOOK_BUFFER",
      "id": "a7ceeae9a1d2471980e2bc71cb38e041"
    },
    {
      "binding": "KNOWLEDGE_BASE",
      "id": "f611edadb19c4260a111eb5796f2fba7"
    }
  ],
  "vars": {
    // Decision Engine (owner 2026-11-10: "nyalakan GLOBAL_DECISION_WEIGHTED"): the B-11 extended witnesses
    // (key levels, regime, cross-timeframe trend, macro drivers; session as context) count in the quorum
    // with the B-11 weights. "false" restores the seven base witnesses.
    "GLOBAL_DECISION_WEIGHTED": "true",
    // Model migration (owner decision 2026-11-07): glm-5.3-flash and nemotron-3-120b-a12b stop
    // answering on 2026-11-20. The news chain and the H1 Reasoner run on gpt-oss-120b.
    "AI_MODEL_ANALYST": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_COUNSELOR": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_REASONER": "@cf/openai/gpt-oss-120b",
    "REQUIRED_SOURCES": "prophet_r38,prophet_r37_ssot,gmi_v12_70",
    // Only H1 webhooks start the AI chain; 5m/15m comparator webhooks are stored for parity only.
    "ANALYSIS_TIMEFRAMES": "60",
    // Local-primary (owner decision 2026-11-05): approved local records drive the chain;
    // TradingView webhooks only calibrate the local engines, for example monthly.
    "INDICATOR_SOURCE": "local",
    "CALIBRATION_INTERVAL_DAYS": "30",
    // Omega broker engine (owner decision 2026-11-09): enabled on the server; controlled live by the
    // "Engine enabled" toggle on the Omega page (and "Arm live" for real accounts).
    "OMEGA_ENGINE_ENABLED": "true",
    // Corpus Oracle phase 1 (owner 2026-11-11): "shadow" keeps the broker M1 corpus of Omega's active
    // broker, pair and user; "off" ignores it. It feeds no decision in phase 1.
    // Owner 2026-11-11 ("Nyalakan, host sudah #243"): collect the broker corpus for the MT5 fallback (docs/RFC_MT5_FALLBACK.md).
    "CORPUS_ORACLE_MODE": "shadow",
    "INGEST_URL": "https://news.cryptophys.work",
    // Multi-agent bus, news threads and live 5m room: ON in production (Phase 4, owner approval 2026-11-04).
    // Shadow/advisory only: none of them writes into the H1 chain's evidence, prompts or decision.
    "MULTI_AGENT_BUS_ENABLED": "true",
    "MULTI_AGENT_MAX_CALLS_PER_HOUR": "20",
    // Per-role models (owner decision 2026-11-07): room agents on gemma-4 (thinking off),
    // moderators and the News Daily TLDR on gpt-oss-120b; each role with its own fallback.
    "ROOM_AGENT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "ROOM_AGENT_FALLBACK_MODEL": "@cf/openai/gpt-oss-20b",
    "MODERATOR_MODEL": "@cf/openai/gpt-oss-120b",
    "MODERATOR_FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "LIVE_ROOM_ENABLED": "true",
    // On in production by owner decision (2026-11-05), after the preview-e2e proof of C5 and C6.
    "HUD_AGENTS_ENABLED": "true",
    // Phase C5: own hourly cap for the HUD agents (13 agents + moderator per H1 run).
    "HUD_AGENTS_MAX_CALLS_PER_HOUR": "30",
    "LIVE_ROOM_MAX_CALLS_PER_HOUR": "48",
    // Live War Room 15m (owner decision 2026-11-05): every agent opens on the bus, debates for at
    // most 3 minutes, and the moderator concludes for the main panel. It replaces the legacy live
    // room and the per-H1 HUD agents. About 30 calls per 15m close since 2026-11-07 (three more
    // agents: Grid Bot Protocol ported, Supertrend and Order Blocks added, P6), so 136 an hour.
    "WAR_ROOM_ENABLED": "true",
    // 2026-11-10: 170 (136 before). The cap counts a rolling 60 minutes and a room can start up to a few
    // minutes late, so the window can hold five rooms; at 15:15 four rooms held 113 calls and the 15m
    // conclusion ran out (budget_exhausted). Five rooms of about 32 calls, with headroom. The cap only
    // bounds a runaway: a room still makes the same calls.
    "WAR_ROOM_MAX_CALLS_PER_HOUR": "170",
    // Timeframe War Rooms (owner decision 2026-11-06): the 1H, 4H and D1 Threads are War Rooms of
    // all agents, one per closed bar (about 29 calls each since 2026-11-07; at most three rooms in
    // one hour).
    "TF_THREADS_ENABLED": "true",
    "TF_THREADS_MAX_CALLS_PER_HOUR": "140",
    "MACRO_ROOM_ENABLED": "true",
    "MACRO_ROOM_MAX_CALLS_PER_HOUR": "30",
    // News Daily (owner decision 2026-11-06): the last 24 hours, each headline tagged once.
    "NEWS_DAILY_ENABLED": "true",
    "NEWS_DAILY_MAX_CALLS_PER_HOUR": "6",
    // Room memo (owner 2026-11-11, "kurangi neuron/hari tanpa mengurangi kapabilitas"): a room step whose
    // whole request equals one answered before reuses that answer (src/room-memo.mjs). "false" = shadow:
    // the hits and the stance agreement are only counted (GET /api/ai-usage) until the owner's go.
    "ROOM_MEMO_ENABLED": "true",
    // Decision Engine Telegram heartbeat (owner 2026-11-11: "telegram bot lebih dari 1 jam tidak mengirim pesan"):
    // one "still WAIT/BUY/SELL" message after this many minutes without a message; "0" turns it off.
    "DECISION_TELEGRAM_HEARTBEAT_MINUTES": "60"
  },
  "routes": [
    {
      "pattern": "ai.cryptophys.work",
      "custom_domain": true
    }
  ],
  "previews": {
    "vars": {
      "AI_MODEL_ANALYST": "@cf/openai/gpt-oss-120b",
      "AI_MODEL_COUNSELOR": "@cf/openai/gpt-oss-120b",
      "AI_MODEL_REASONER": "@cf/openai/gpt-oss-120b",
      "REQUIRED_SOURCES": "prophet_r38,prophet_r37_ssot,gmi_v12_70",
      "INGEST_URL": "https://xauusd-fundamental-news-ingestion-preview.workers.dev"
    },
    "kv_namespaces": [
      {
        "binding": "SIGNAL_CACHE",
        "id": "0cbd6ecc0fbc4dc99342960456ca71e5"
      },
      {
        "binding": "WEBHOOK_BUFFER",
        "id": "2000943b5db042f582b03043c75d5b1c"
      },
      {
        "binding": "KNOWLEDGE_BASE",
        "id": "773182e4a26c444e8f56c3e58a1987ef"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "90f53f14-ff7b-46c1-b146-a1efd4e13018"
      }
    ],
    "ai": {
      "binding": "AI"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "services": [
    {
      "binding": "NEWS_INGESTION",
      "service": "xauusd-fundamental-news-ingestion",
      "entrypoint": "NewsIngestionService",
      "environment": "production"
    },
    // Cryptophys Platform AI Kernel (RFC_INDICATOR_AGENT_PLATFORM P4): advisory reports from the
    // 21 agents this Worker hosts. No secret: the kernel trusts the pinned host_worker. Never
    // change host_worker, and never add this binding to another Worker or to the preview config.
    {
      "binding": "AGENTS",
      "service": "cryptophys-ai-kernel",
      "entrypoint": "AgentRpc",
      "props": { "host_worker": "xauusd-ai-trading-assistant" }
    },
    // Aether, the Knowledge Guardian (RFC_AETHER_KNOWLEDGE_GUARDIAN A5, owner go 2026-11-07): the sweep
    // pushes decision cards (no levels) to cryptophys-aether KnowledgeIngress, hourly. No secret.
    // Production only; never add it to the preview config.
    {
      "binding": "AETHER",
      "service": "cryptophys-aether",
      "entrypoint": "KnowledgeIngress"
    },
    // Aether's read-only sync checks (hardening 2026-11-09): the health alerts read AetherReader.sync()
    // every 15 minutes and compare Aether's KB hash with this repository's. Production only.
    {
      "binding": "AETHER_READER",
      "service": "cryptophys-aether",
      "entrypoint": "AetherReader"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "XAUUSD_EVENTS",
        "queue": "xauusd-webhook-events"
      }
    ],
    "consumers": [
      {
        "queue": "xauusd-webhook-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "xauusd-webhook-events-dlq",
        "retry_delay": 30,
        "max_concurrency": 1
      }
    ]
  }
}
