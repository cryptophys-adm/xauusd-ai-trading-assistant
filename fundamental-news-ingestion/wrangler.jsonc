{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Name kept for continuity (OAuth redirect https://news.cryptophys.work/oauth/callback,
  // secrets, Workers Builds, Service Bindings). Role: the single TradingView MCP gateway —
  // fundamental news (HTTP /pull + cron) and OHLCV for local engines (RPC entrypoint TvGateway).
  "name": "xauusd-fundamental-news-ingestion",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "OAUTH_STORE",
      "id": "a1c0f1055bd1434192d681a45866614d"
    }
  ],
  "vars": {
    "TV_MCP_CLIENT_ID": "a2g7N_GyGRM3U9X7pHeBcGBP1eK0ZdlN",
    "TV_MCP_METADATA_URL": "https://www.tradingview.com/.well-known/oauth-authorization-server",
    "TV_MCP_REDIRECT_URI": "https://news.cryptophys.work/oauth/callback",
    "TV_MCP_SCOPE": "mcp:read mcp:tools",
    "TV_MCP_TOKEN_AUTH_METHOD": "none"
  },
  // Operational verification: require one fresh scheduled ingestion result after deployment.
  // Verify the next scheduled pull after deploying safe upstream diagnostics.
  // Verify the latest sanitized upstream error diagnostics in production health output.
  // Workers Builds branch previews (`wrangler preview`, newer wrangler requires this block; WB1, 2026-11-25).
  // Preview-safe only: placeholder OAuth values so a preview can never act as the production TradingView client
  // (no token is ever stored there, so the preview's pulls fail closed), and the existing preview-only KV
  // namespace xauusd-preview-signal-cache for OAUTH_STORE (never the production xauusd-fundamental-news-oauth).
  // No secrets here. The production deploy (deploy-fundamental-news-ingestion.yml) does not read this block.
  "previews": {
    "vars": {
      "TV_MCP_CLIENT_ID": "preview-placeholder",
      "TV_MCP_METADATA_URL": "https://www.tradingview.com/.well-known/oauth-authorization-server",
      "TV_MCP_REDIRECT_URI": "https://preview.invalid/oauth/callback",
      "TV_MCP_SCOPE": "mcp:read mcp:tools",
      "TV_MCP_TOKEN_AUTH_METHOD": "none"
    },
    "kv_namespaces": [
      {
        "binding": "OAUTH_STORE",
        "id": "0cbd6ecc0fbc4dc99342960456ca71e5"
      }
    ]
  },
  "triggers": {
    // :04 (owner 2026-11-14, the TradingView quota): two minutes before the AI Worker's hourly news
    // analysis (:06), so its pull reads this pull's shared copy instead of calling the provider again.
    "crons": ["4 * * * *"]
  },
  // Workers Logs (2026-11-27, orchestrator): the O5 refusal log (`tv_quota_refusal`) and the ingest summaries are
  // kept. Every console line of this Worker is sanitized or carries counts and codes only (sanitizeText).
  // Invocation logs stay off: they record each request's URL, and /oauth/callback?code=... carries the OAuth code.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  }
}
