{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "xauusd-fundamental-news-ingestion",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "vars": {
    "TRADINGVIEW_MCP_URL": "https://mcp.tradingview.com/mcp",
    "TV_MCP_REDIRECT_URI": "https://news.cryptophys.work/oauth/callback",
    "TV_SYMBOLS": "OANDA:XAUUSD,TVC:USOIL,TVC:DXY"
  },
  "kv_namespaces": [
    {
      "binding": "TV_OAUTH_KV",
      "id": "a1c0f1055bd1434192d681a45866614d"
    }
  ]
}
